{
  "version": 1,
  "brandId": "tech-instagram",
  "id": "api-timeout-idempotency-interview-trap",
  "title": "Database says SUCCESS. Client says TIMEOUT.",
  "accent": "#efc373",
  "style": "orbital",
  "voice": "TECH_ENGLISH_INDIA",
  "lang": "en",
  "sourceReview": {
    "status": "NEEDS_REVIEW",
    "learningGoal": "Show that a lost response is an unknown outcome, then teach stable idempotency keys, UNIQUE constraints, and atomic write of order plus idempotency result.",
    "caveat": "Timeout does not prove the write succeeded either — it proves the client does not know. Numbers and order IDs are illustrative.",
    "claims": [
      {
        "claim": "A client timeout or lost response does not necessarily mean a mutating operation failed.",
        "sourceUrl": "https://aws.amazon.com/builders-library/making-retries-safe-with-idempotent-APIs/"
      },
      {
        "claim": "Reusing the same idempotency key lets a server recognize retries of one logical operation.",
        "sourceUrl": "https://stripe.com/docs/api/idempotent_requests"
      },
      {
        "claim": "A unique constraint on an idempotency key prevents two concurrent claims of the same key.",
        "sourceUrl": "https://www.postgresql.org/docs/current/ddl-constraints.html"
      },
      {
        "claim": "Persisting the business write and idempotency record in one transaction closes the crash window between them.",
        "sourceUrl": "https://aws.amazon.com/builders-library/making-retries-safe-with-idempotent-APIs/"
      }
    ]
  },
