  "sourceReview": {
    "status": "NEEDS_REVIEW",
    "learningGoal": "Explain deep OFFSET cost and inconsistency, then stable cursor pagination with created_at plus id and a matching index.",
    "caveat": "OFFSET is not always wrong — it remains fine for small sets, shallow pages, admin tables, and arbitrary page jumps. Numbers are illustrative.",
    "claims": [
      {
        "claim": "Large OFFSET values force the database to scan and discard preceding rows before returning LIMIT rows.",
        "sourceUrl": "https://use-the-index-luke.com/no-offset"
      },
      {
        "claim": "Offset pagination can duplicate or skip rows when the ordered dataset changes between page fetches.",
        "sourceUrl": "https://use-the-index-luke.com/no-offset"
      },
      {
        "claim": "Keyset / cursor pagination continues from the last seen ordering key instead of re-skipping earlier rows.",
        "sourceUrl": "https://use-the-index-luke.com/sql/partial-results/fetch-next-page"
      },
      {
        "claim": "A composite cursor such as created_at plus unique id keeps order deterministic when timestamps collide.",
        "sourceUrl": "https://www.postgresql.org/docs/current/indexes-btree.html"
      }
    ]
  },
