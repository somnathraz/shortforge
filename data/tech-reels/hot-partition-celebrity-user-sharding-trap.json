  "sourceReview": {
    "status": "NEEDS_REVIEW",
    "learningGoal": "Show that hash sharding balances keys, not skewed access; a celebrity hot key creates a hot partition; fix with cache/replicas/hybrid fan-out, not only more shards.",
    "caveat": "Shard counts, CPU percentages, and read rates are illustrative storytelling numbers. No claim about any specific company's current architecture.",
    "claims": [
      {
        "claim": "Hash-based sharding on user_id distributes stored keys evenly when the user population is large and uniform.",
        "sourceUrl": "https://en.wikipedia.org/wiki/Hash_function#Uses"
      },
      {
        "claim": "A single highly requested key always maps to the same shard, so skewed access can concentrate load on one partition (hot key / hot partition).",
        "sourceUrl": "https://docs.aws.amazon.com/AmazonElastiCache/latest/red-ug/Strategies.html"
      },
      {
        "claim": "Increasing shard count does not by itself spread traffic for one deterministic key — that key still lands on exactly one shard.",
        "sourceUrl": "https://en.wikipedia.org/wiki/Consistent_hashing"
      },
      {
        "claim": "Caching hot keys and adding read capacity for the affected shard are common mitigations before re-sharding the key space.",
        "sourceUrl": "https://redis.io/docs/latest/develop/use/patterns/distributed-locks/"
      }
    ]
  },
