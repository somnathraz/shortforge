  "sourceReview": {
    "status": "NEEDS_REVIEW",
    "learningGoal": "Teach senior production response to critical PHP runtime vulnerabilities: inventory exposure, WAF as temporary containment, controlled canary patching, verification, and post-patch investigation — without exploit how-to.",
    "caveat": "PHP2Shell and fleet counts are illustrative incident storytelling. No exploitation payloads or bypass instructions. Patch version numbers refer to public PHP security advisories.",
    "claims": [
      {
        "claim": "PHP released emergency security updates for critical remote code execution vulnerabilities; upgrading the runtime is the complete remediation.",
        "sourceUrl": "https://www.php.net/downloads.php"
      },
      {
        "claim": "PHP documents that there are no complete mitigations other than updating vulnerable installations.",
        "sourceUrl": "https://www.php.net/manual/en/security.php"
      },
      {
        "claim": "AWS reported observing exploitation attempts related to PHP runtime vulnerabilities before broad public disclosure.",
        "sourceUrl": "https://aws.amazon.com/blogs/security/"
      },
      {
        "claim": "A WAF or exposure reduction can limit immediate risk but does not replace patching the vulnerable runtime.",
        "sourceUrl": "https://owasp.org/www-community/Web_Application_Firewall"
      },
      {
        "claim": "After possible exploitation, defenders should review logs and investigate unexpected process or file activity, not assume patch alone proves a clean host.",
        "sourceUrl": "https://csrc.nist.gov/publications/detail/sp/800-61/rev-2/final"
      }
    ]
  },
