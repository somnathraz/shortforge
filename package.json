    "node-edge-tts": "^1.2.10",
    "sharp": "^0.35.5",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/sharp": "^0.31.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
