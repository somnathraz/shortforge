    "publish": "node --import tsx src/cli/publish.ts",
    "publish:due": "node --import tsx src/cli/publish-due.ts",
    "publish:youtube-auth": "node --import tsx src/cli/youtube-auth.ts",
    "publish:instagram-auth": "node --import tsx src/cli/instagram-auth.ts",
    "publish:instagram-refresh": "node --import tsx src/cli/instagram-refresh.ts",
    "publish:s3-upload": "node --import tsx src/cli/s3-upload.ts",
