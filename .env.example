# Desk operator login (home → /login → /desk)
# No default password. With none set, the first `npm run ui` generates one, prints it once,
# and stores only its hash in data/desk-auth.json. To choose your own:
#   npm run desk:password -- 'your password'   → paste the HASH line below
DESK_AUTH_EMAIL=
DESK_AUTH_PASSWORD_HASH=
# DESK_AUTH_PASSWORD=            # plain-text alternative (less safe)
# Session-signing secret; auto-generated per install in data/desk-auth.json if unset
# DESK_AUTH_SECRET=
# Extra Host headers allowed to reach /api (e.g. your tunnel domain). localhost is always allowed.
# DESK_ALLOWED_HOSTS=

OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
DEFAULT_LANGUAGE=hi
OLLAMA_TIMEOUT_MS=180000
EPISODES_DIR=data/episodes
# gemini | ollama | nvidia | openai | openrouter | groq
STORY_PROVIDER=openrouter
DEFAULT_STORY_KIND=canonical
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_TIMEOUT_MS=120000
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_STORY_MODEL=gpt-5.6-sol
OPENAI_REASONING_EFFORT=low
OPENAI_TIMEOUT_MS=120000

# Free hosted story providers (no local GPU/RAM)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Pin a currently free model from https://openrouter.ai/models?q=free (list rotates).
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_TIMEOUT_MS=180000
# Packaging JSON needs headroom; reasoning models otherwise empty/truncate at 4k.
OPENROUTER_MAX_TOKENS=16384
OPENROUTER_REASONING_EFFORT=low
OPENROUTER_SITE_URL=https://github.com/mythology-factory
OPENROUTER_APP_NAME=mythology-factory
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_MS=120000

# Free Hindi narration (Microsoft Edge neural voices — no API key)
EDGE_TTS_VOICE=hi-IN-MadhurNeural
EDGE_TTS_LANG=hi-IN
EDGE_TTS_RATE=default
EDGE_TTS_TIMEOUT_MS=180000
TTS_OUTPUT_DIR=output/audio

# Premium narration (EpicAstra mythology uses ELEVENLABS_VOICE_ID)
ELEVENLABS_API_KEY=
# Default mythology voice when UI/CLI does not pass --voice
ELEVENLABS_VOICE_ID=
# Tech Reels ignore ELEVENLABS_VOICE_ID — locked profile TECH_ENGLISH_INDIA (Rahul Bharadwaj / male Indian English).
# TECH_ELEVENLABS_VOICE_ID=u7bRcYbD7visSINTyAT8

# Load multiple voices into the UI picker (any combo works):
#   ELEVENLABS_VOICES=Channel narrator:mSYK1wXyDo9la60dBOyK,Hindi female:sRieWHKeAAU4rWvQs6uN
#   ELEVENLABS_VOICE_IDS=mSYK1wXyDo9la60dBOyK,ycM2sXpcoLsM3MLrYLgq,sRieWHKeAAU4rWvQs6uN
#   ELEVENLABS_VOICE_1_ID=…  ELEVENLABS_VOICE_1_LABEL=Channel narrator
#   ELEVENLABS_VOICE_2_ID=…  ELEVENLABS_VOICE_2_LABEL=Hindi female
# ELEVENLABS_VOICES=
# ELEVENLABS_VOICE_IDS=
# Optional curated labels file: config/elevenlabs-voices.json
# UI also loads voices from your ElevenLabs account when the API key is set.
# Mythology + Tech: prefer eleven_v4 (audio tags; stability+similarity only — no style/speed/SSML)
ELEVENLABS_MODEL=eleven_v4
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_TIMEOUT_MS=120000
# SFX: generate into assets/audio/sfx/custom/ only when library file is missing
ELEVENLABS_SFX_ON_MISS=true
# Music: hero Reels only (npm run audio:hero-bgm / audio:mix --hero-bgm)
ELEVENLABS_MUSIC_MODEL=music_v1
ELEVENLABS_MUSIC_TIMEOUT_MS=300000
# HERO_REEL=true

# Sound Director (LLM plan → local/custom SFX + BGM → one final mix)
# gemini | openrouter | groq | openai; blank falls back to STORY_PROVIDER
SOUND_DIRECTOR_PROVIDER=
SOUND_DIRECTOR_AUTO_PLAN=true
# Re-time old scene-planned cues when finished narration is available
AUDIO_REPLAN_ON_NARRATION=true
# Produce automatically builds the final audio mix unless set false
AUDIO_AUTO_MIX=false
SFX_DIR=assets/audio/sfx
BGM_DIR=assets/audio/bgm
AUDIO_OUTPUT_DIR=output/audio
# Narrator remains foreground; SFX are accents
SFX_NARRATION_GAIN=1.05
SFX_MIX_GAIN=0.22
# Soft bed: normalize to -30 LUFS, then trim by 0.5 (~-36 LUFS before ducking).
BGM_LOUDNORM=true
BGM_LOUDNORM_I=-30
BGM_VOLUME=0.5
BGM_ATEMPO=1.0
# Duck music under speech so the narration stays clear.
BGM_DUCK=true

# Sarvam AI Hindi TTS (Bulbul) — https://docs.sarvam.ai/api-reference/text-to-speech/convert
SARVAM_API_KEY=
# Speaker id (lowercase): shubh, priya, ritu, aditya, … see config/sarvam-voices.json
SARVAM_SPEAKER=shubh
SARVAM_MODEL=bulbul:v3
SARVAM_LANGUAGE=hi-IN
SARVAM_PACE=1.0
SARVAM_SAMPLE_RATE=24000
SARVAM_OUTPUT_CODEC=mp3
SARVAM_TEMPERATURE=0.6
SARVAM_TIMEOUT_MS=120000
TTS_OUTPUT_DIR=output/audio

# Scene stills (Phase 3)
# pollinations (free, default) | gemini
IMAGE_PROVIDER=pollinations
IMAGES_DIR=output/images
IMAGE_WIDTH=1080
IMAGE_HEIGHT=1920
IMAGE_REQUEST_DELAY_MS=1500
POLLINATIONS_BASE_URL=https://image.pollinations.ai
POLLINATIONS_MODEL=flux
POLLINATIONS_TIMEOUT_MS=180000
POLLINATIONS_API_KEY=
GOOGLE_IMAGE_TIMEOUT_MS=180000

# Path A — FFmpeg motion Short (stills + Ken Burns) → output/video/
VIDEO_OUTPUT_DIR=output/video
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
VIDEO_MOTION=medium
VIDEO_BURN_SUBTITLES=true
VIDEO_FONT_FILE=/System/Library/Fonts/Kohinoor.ttc

# Final composer → output/final/<episodeId>.mp4 (+ .production.json)
FINAL_OUTPUT_DIR=output/final
CHARACTERS_DIR=characters
AI_VIDEO_MAX_ATTEMPTS=2
WAN_GPU_USD_PER_HOUR=0.35
WAN_GPU_LABEL=RTX4090

# Path B — AI animate (pluggable: veo | wan) → output/ai-video/
# npm run animate -- --provider veo|wan --episode data/episodes/file.json [--scene 4]
# npm run produce -- --episode … --provider wan   # STILL=ffmpeg + AI_VIDEO=provider → final
AI_VIDEO_DIR=output/ai-video
AI_VIDEO_PROVIDER=wan
VEO_OUTPUT_DIR=output/veo
VEO_MODEL=veo-3.1-generate-preview
VEO_TIMEOUT_MS=600000
VEO_POLL_MS=8000

# Premium image/video providers (routing support; adapters are added by phase)
GOOGLE_AI_API_KEY=
GOOGLE_TEXT_MODEL=gemini-3.8-flash
GOOGLE_TEXT_TIMEOUT_MS=120000
# Production stills (Nano Banana 2.1). Drafts: gemini-3.1-flash-lite-image. Heroes: gemini-3-pro-image.
GOOGLE_IMAGE_MODEL=gemini-3.1-flash-image
GOOGLE_IMAGE_SIZE=2K
GOOGLE_HERO_IMAGE_MODEL=gemini-3-pro-image
# Optional Gemini refs (style / character). Previous scene is auto-attached when present.
# EPICASTRA_STYLE_REFERENCE_IMAGE=output/images/_style/master-style.png
# EPICASTRA_CHARACTER_REFERENCE_IMAGE=characters/ganga/master.png
GOOGLE_VIDEO_MODEL=gemini-omni-1.1-flash
GOOGLE_HERO_VIDEO_MODEL=veo-3.1-generate-preview

# Video, easiest path — Runway hosted API (no GPU, no tunnel, no ComfyUI):
#   1. dev.runwayml.com → create an API key, buy credits ($10 minimum, $0.01 per credit)
#   2. set RUNWAY_API_KEY below and VIDEO_PROVIDER=runway
# gen4_turbo = 5 credits/sec ≈ $0.05/sec (≈ $0.25 per 5s clip). Other models: docs/video-providers.md
RUNWAY_API_KEY=
RUNWAY_VIDEO_MODEL=gen4_turbo
# RUNWAY_RATIO=720:1280        # 9:16; must be valid for the chosen model
# RUNWAY_DURATIONS=5,10        # allowed clip lengths (gen4_turbo accepts any 2–10)
# VIDEO_PROVIDER=runway        # runway | wan-comfyui. Unset = runway if a key is set and no GPU host is configured

# Video: Wan via ComfyUI (Vast / RunPod) — preferred for I2V, no driving clip
# Architecture: Mac = brain. GPU box = ComfyUI.
#   1) ComfyUI on the GPU box (this setup: 127.0.0.1:8080)
#   2) SSH tunnel: npm run wan:tunnel:comfy   (reads WAN_COMFY_SSH_* from .env)
#      or: ssh -p PORT root@HOST -L 8080:localhost:8080
#   3) Desk talks to WAN_COMFY_URL (localhost:8080) → tunnel → remote ComfyUI
#   4) FFmpeg on Mac assembles clips + narration
# Keep tunnel open while generating.
# Tunnel: Mac LOCAL_PORT → remote REMOTE_PORT
# Vast templates often run Comfy on 18188 (8080 = Jupyter). Confirm with:
#   ssh … 'curl -s -o /dev/null -w "%{http_code}" http://127.0.0.1:18188/system_stats'
WAN_COMFY_LOCAL_PORT=8080
WAN_COMFY_REMOTE_PORT=18188
WAN_COMFY_SSH_HOST=
WAN_COMFY_SSH_PORT=
WAN_COMFY_SSH_USER=root
WAN_COMFY_SSH_KEY=~/.ssh/id_vastai
# Export Wan I2V workflow once: ComfyUI → Save (API Format) → WAN_COMFY_WORKFLOW path
WAN_BACKEND=comfy
# Alias-friendly: COMFYUI_URL is accepted if WAN_COMFY_URL is unset (see wan-comfy.ts)
WAN_COMFY_URL=http://127.0.0.1:8080
# COMFYUI_URL=http://127.0.0.1:8080   # uncomment only if you run your own ComfyUI/GPU
WAN_COMFY_WORKFLOW=workflows/wan/wan22-i2v-a14b-api.json
# Vertical Short defaults (override after a successful Comfy UI test)
WAN_COMFY_WIDTH=704
WAN_COMFY_HEIGHT=1280
# Duration × FPS + 1 is derived inside the workflow (node 129:163).
# Scene narration duration is snapped onto a 4n+1 frame grid (see src/lib/wanTiming.ts).
WAN_COMFY_FPS=16
# Fallback only when a caller omits scene narration duration:
WAN_COMFY_DURATION_SECONDS=5
# Max latent length (4n+1). 193 ≈ 12s @ 16fps — covers typical TTS scene speech.
# Lower to 129 (~8s) if VRAM is tight; Wan will clamp longer TTS and freeze-pad on produce.
WAN_COMFY_MAX_FRAMES=193
WAN_COMFY_FRAMES=129
WAN_COMFY_TIMEOUT_MS=1800000
# Sampler: quality = 20-step baseline (~14–15 min/scene); fast = LightX2V 4-step LoRA
# UI also has a Sampler mode select — override per job without changing .env
WAN_COMFY_QUALITY_MODE=quality
# VIDEO_PROVIDER / AI_VIDEO_PROVIDER: runway | wan-comfyui (aliases: wan, comfy). Left unset, Runway is used when
# RUNWAY_API_KEY is set and no GPU host is configured; otherwise Wan. See docs/video-providers.md
# VIDEO_PROVIDER=wan-comfyui
# AI_VIDEO_PROVIDER=wan
# Export API workflow from ComfyUI first (see workflows/wan/README.md + NODE_MAP.md)

# Video generation: Wan2.2-Animate-2-14B NIM (optional; WAN_BACKEND=nim)
# NGC_API_KEY is only used on the NVIDIA GPU host to pull/start the container.
NGC_API_KEY=
HF_TOKEN=
# With SSH tunnel from Mac: use localhost. Without tunnel: use private pod IP (not public).
WAN_NIM_BASE_URL=http://127.0.0.1:8000
WAN_NIM_API_KEY=
WAN_NIM_MODEL=Wan2.2-Animate-2-14B
WAN_NIM_TIMEOUT_MS=900000
WAN_NIM_SEED=0
WAN_OUTPUT_DIR=output/wan
WAN_DRIVE_VIDEO=assets/driving/default.mp4

# Publish packaging (titles / descriptions / tags / covers per platform)
PACKAGING_DIR=output/packaging
PACKAGING_IMAGE_PROVIDER=pollinations
PACKAGING_LANGUAGE=hi

# Publish (only after npm run review --action APPROVE) — docs/publish-setup.md
PUBLISH_DIR=output/publish
PUBLISH_PLATFORMS=youtube,instagram,facebook
PUBLISH_DRY_RUN=false
# Optional public HTTPS mp4 for Instagram Reels API
PUBLISH_VIDEO_PUBLIC_URL=

# YouTube Data API (one Google OAuth client for all pipelines)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Legacy / EpicAstra fallback — prefer Desk Authorize YouTube (per-brand vault)
YOUTUBE_REFRESH_TOKEN=
# OAuth callback — same URI for CLI + Desk Authorize YouTube (must match Google Cloud)
YOUTUBE_REDIRECT_URI=http://localhost:8765/oauth2callback
# Optional override if you register a Desk-only redirect instead
# YOUTUBE_DESK_REDIRECT_URI=http://localhost:8765/oauth2callback
YOUTUBE_PRIVACY=private
YOUTUBE_CATEGORY_ID=24
YOUTUBE_UPLOAD_TIMEOUT_MS=900000
# Separate analytics dashboard (npm run analytics:ui) — default 8790
# ANALYTICS_PORT=8790
# ANALYTICS_HOST=127.0.0.1

# Meta: Facebook Page
META_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
FACEBOOK_PUBLISH_IMMEDIATELY=true
META_GRAPH_VERSION=v21.0
META_UPLOAD_TIMEOUT_MS=900000

# Instagram — prefer Instagram Login (no Facebook Page required)
# App credentials for OAuth (npm run publish:instagram-auth / Desk “Authorize Instagram”):
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Desk callback (default). Must match Meta app Redirect URI exactly:
# INSTAGRAM_REDIRECT_URI=http://127.0.0.1:8787/api/publish/instagram-oauth/callback
# CLI callback (npm run publish:instagram-auth uses port 8766 if unset):
# INSTAGRAM_OAUTH_PORT=8766
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_API_BASE=https://graph.instagram.com
INSTAGRAM_GRAPH_VERSION=v21.0
# Fallback (Facebook Login / Page-linked IG):
# INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_SHARE_TO_FEED=true
INSTAGRAM_PROCESS_TIMEOUT_MS=300000
# Public HTTPS MP4 for Reels (optional if S3 auto-upload is configured):
# PUBLISH_VIDEO_PUBLIC_URL=
# META_REEL_VIDEO_URL=

# S3 / R2 — auto-host Instagram Reel MP4 as a public HTTPS URL
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET=
S3_PREFIX=mythology-factory/reels/
# Keep timestamped copies per episode instead of overwriting short.mp4:
# S3_KEEP_VERSIONS=true
# Optional CloudFront / custom domain (no trailing slash):
# S3_PUBLIC_BASE_URL=https://cdn.example.com
# If bucket still allows ACLs:
# S3_OBJECT_ACL=public-read
# Cloudflare R2 example:
# S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# S3_FORCE_PATH_STYLE=true
# S3_PUBLIC_BASE_URL=https://pub-xxxxx.r2.dev

# Optional isolated fal video experiments (npm run video:experiment -- --help)
# Server-side only. No paid requests are made by the plan command.
FAL_KEY=

# Comment → DM (Instagram/Facebook private replies). Links live in config/brands/<brand>.json → commentDm.
# Meta app dashboard → Webhooks: callback https://<public-host>/api/webhooks/meta, verify token below,
# subscribe Instagram "comments" (and Page "feed"). Needs instagram_manage_comments + instagram_manage_messages.
META_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=
